<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>Script: VA: Save</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>作成: WebViewer から渡された Data API 互換 JSON で</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>      Exm_VisualAcuity_Summary を 1 回の Data API コールで upsert</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>呼出: WebViewer JS の FileMaker.PerformScript("VA: Save", payload)</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>引数: WebViewer のペイロード JSON (json-schema.js buildSavePayload)</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>引数取得</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "mode" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$mode</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.layout" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$layout</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.recordId" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$recordId</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.request" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$request</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>validation</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $payload ) or IsEmpty ( $mode ) or IsEmpty ( $layout ) or IsEmpty ( $request )]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[JSONSetElement ( "" ;
  [ "messages[0].code"    ; "9999"          ; JSONString ] ;
  [ "messages[0].message" ; "invalid payload" ; JSONString ]
)]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>Data API リクエスト組立: action / layouts / (recordId) を付与</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $request ;
  [ "action"  ; $mode    ; JSONString ] ;
  [ "layouts" ; $layout  ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$apiRequest</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[$mode = "update"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $apiRequest ; "recordId" ; $recordId ; JSONString )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$apiRequest</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>===== ここに「Execute FileMaker Data API」ステップを追加 =====</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>  Target: 変数  → 名前: $result, リピート: 1</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>  Request: 計算 → $apiRequest</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>※ 下のプレースホルダ Set Variable は実ステップ追加後に削除</Text></Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["PLACEHOLDER: Execute FileMaker Data API ( request: $apiRequest ; target: $result )"]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>===== ここに「Perform JavaScript in Web Viewer」ステップを追加 =====</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>  オブジェクト名: VA_WebViewer</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>  関数名: 計算 → "__fmSaveResult"</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>  パラメータ 1: $result</Text></Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$result]]></Calculation>
  </Step>
</fmxmlsnippet>
