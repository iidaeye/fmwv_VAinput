<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>Script: VA: Save</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>作成: WebViewer から渡された Data API 互換 JSON で</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>      Exm_VisualAcuity_Summary を 1 回の Data API コールで upsert</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>呼出: WebViewer JS の FileMaker.PerformScript("VA: Save", payload)</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>引数: WebViewer のペイロード JSON (json-schema.js buildSavePayload)</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>注: 全 exit 経路で __fmSaveResult を呼ぶこと。1 経路でも欠けると JS 側の</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>    expect("save") promise が tied になり「previous save still pending」になる。</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>エラー時もスクリプトを継続させ、Get(LastError) で拾う</Text></Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>引数取得</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "mode" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$mode</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.layout" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$layout</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.recordId" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$recordId</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "summary.request" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$request</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>validation</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $payload ) or IsEmpty ( $mode ) or IsEmpty ( $layout ) or IsEmpty ( $request )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "" ;
  [ "messages[0].code"    ; "9999"            ; JSONString ] ;
  [ "messages[0].message" ; "invalid payload" ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title><Calculation><![CDATA["debug VA: Save (invalid payload)"]]></Calculation></Title>
    <Message><Calculation><![CDATA["payload:" & ¶ & $payload & ¶ & ¶ &
"mode: " & $mode & ¶ &
"layout: " & $layout & ¶ &
"request: " & $request]]></Calculation></Message>
    <Buttons>
      <Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA["VA_WebViewer"]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["__fmSaveResult"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[$result]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$result]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>Data API リクエスト組立: $request に layouts (+ recordId) を付与</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $request ; "layouts" ; $layout ; JSONString )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$apiRequest</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[$mode = "update"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $apiRequest ; "recordId" ; $recordId ; JSONString )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$apiRequest</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[""]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="203" name="Execute FileMaker Data API">
    <SelectAll state="True"/>
    <Calculation><![CDATA[$apiRequest]]></Calculation>
    <Text/>
    <Field>$result</Field>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$err</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>Execute FileMaker Data API がエラーを返した場合（権限・レイアウト名等）、</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>$result が空のままになる可能性があるので診断 JSON を入れる</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[$err ≠ 0 or IsEmpty ( $result )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "" ;
  [ "messages[0].code"    ; GetAsText ( $err )                                       ; JSONString ] ;
  [ "messages[0].message" ; "FM error " & $err & " (Execute FileMaker Data API)"     ; JSONString ] ;
  [ "diagnostics.layout"  ; $layout                                                  ; JSONString ] ;
  [ "diagnostics.mode"    ; $mode                                                    ; JSONString ] ;
  [ "diagnostics.recordId"; $recordId                                                ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>★ DEBUG: 動作確認後は enable="False" に戻して良い</Text></Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title><Calculation><![CDATA["debug VA: Save"]]></Calculation></Title>
    <Message><Calculation><![CDATA["mode: " & $mode & ¶ &
"layout: " & $layout & ¶ &
"recordId: " & $recordId & ¶ & ¶ &
"apiRequest:" & ¶ & $apiRequest & ¶ & ¶ &
"err: " & $err & ¶ & ¶ &
"result:" & ¶ & $result]]></Calculation></Message>
    <Buttons>
      <Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>WebViewer に保存結果（または診断 error JSON）を返す</Text></Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA["VA_WebViewer"]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["__fmSaveResult"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[$result]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$result]]></Calculation>
  </Step>
</fmxmlsnippet>
