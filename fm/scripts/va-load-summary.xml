<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>Script: VA: Load Summary</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>作成: 既存サマリの内容を WebViewer に読み込む</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>呼出: WebViewer JS の FileMaker.PerformScript("VA: Load Summary", { recordId })</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>引数: { "recordId": "..." }   ※ FM 内部 recordId（__k ではない）</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>注: 全 exit 経路で __fmReceiveSummary を呼ぶこと。</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$param</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $param ; "recordId" )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$recordId</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["api_Exm_VisualAcuity_Summary"]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$layout</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>validation: recordId 必須</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $recordId )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "" ;
  [ "messages[0].code"    ; "9999"                ; JSONString ] ;
  [ "messages[0].message" ; "recordId is required" ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA["VA_WebViewer"]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["__fmReceiveSummary"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[$result]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$result]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>Data API リクエスト: layouts + recordId のみ。recordId 指定の getRecord</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>action は read だが recordId 指定時は省略可。明示しておく。</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "" ;
  [ "layouts"  ; $layout    ; JSONString ] ;
  [ "action"   ; "read"     ; JSONString ] ;
  [ "recordId" ; $recordId  ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$apiRequest</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[""]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="203" name="Execute FileMaker Data API">
    <SelectAll state="True"/>
    <Calculation><![CDATA[$apiRequest]]></Calculation>
    <Text/>
    <Field>$result</Field>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$err</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[$result]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$rawResult</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>応答が空の場合だけ診断 JSON で代替（FM が messages を返すなら生 JSON をそのまま流す）</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $result )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "" ;
  [ "messages[0].code"    ; GetAsText ( $err )                            ; JSONString ] ;
  [ "messages[0].message" ; "FM error " & $err & " (no body returned)"    ; JSONString ] ;
  [ "diagnostics.layout"  ; $layout                                       ; JSONString ] ;
  [ "diagnostics.recordId"; $recordId                                     ; JSONString ]
)]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$result</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["===== VA: Load Summary debug =====" & ¶ &
"recordId: " & $recordId & ¶ &
"layout:   " & $layout & ¶ &
"err:      " & $err & ¶ &
¶ &
"---- apiRequest ----" & ¶ & $apiRequest & ¶ &
¶ &
"---- rawResult (len=" & Length ( $rawResult ) & ") ----" & ¶ &
Left ( $rawResult ; 4000 ) & ¶ &
"===== /debug ====="]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$d_debug</Name>
  </Step>
  <Step enable="False" id="87" name="Show Custom Dialog">
    <Title><Calculation><![CDATA["debug VA: Load Summary"]]></Calculation></Title>
    <Message><Calculation><![CDATA[$d_debug]]></Calculation></Message>
    <Buttons>
      <Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>WebViewer に既存サマリの内容を返す</Text></Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA["VA_WebViewer"]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["__fmReceiveSummary"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[$result]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$result]]></Calculation>
  </Step>
</fmxmlsnippet>
