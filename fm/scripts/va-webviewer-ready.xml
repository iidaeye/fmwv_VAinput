<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>Script: VA: WebViewer Ready</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>作成: WebViewer 側の JS が読み込み完了したことを受け、init JSON を注入する</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>呼出: WebViewer の fm-bridge.js から FileMaker.PerformScript("VA: WebViewer Ready")</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>引数: なし（必要なら ScriptParameter を受け取れる）</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>事前条件: $$VA_initJSON が "VA: Open WebViewer" によりセット済み</Text></Step>
  <Step enable="True" id="89" name="# (comment)"><Text>========================================</Text></Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>init JSON が無ければ何もしない（再読込・予期せぬ呼出への保険）</Text></Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $$VA_initJSON )]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA["error: $$VA_initJSON is empty"]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>WebViewer 表示対象オブジェクト名（VA: Open WebViewer と一致させる）</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["VA_WebViewer"]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$objectName</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>WebViewer に init JSON を注入</Text></Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA[$objectName]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["__fmSetInit"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[$$VA_initJSON]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)"><Text>二重注入防止のためクリア</Text></Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[""]]></Calculation></Value>
    <Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
    <Name>$$VA_initJSON</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA["ok"]]></Calculation>
  </Step>
</fmxmlsnippet>
