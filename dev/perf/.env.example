# FileMaker Data API 計測スクリプト用 環境変数サンプル
# cp .env.example .env し、各値を埋めて使う（.env は .gitignore 済み想定）

# FM Server のホスト (https://)
FM_HOST=https://fms.example.com

# データベース名 (URL エンコード前のプレーン名)
FM_DB=YourDatabase

# 計測専用アカウント
FM_USER=va_perf_probe
FM_PASS=changeme

# 計測対象レイアウト
FM_LAYOUT=api_Exm_VisualAcuity_Summary

# テスト患者・テストレコード (壊しても良いもの)
FM_PT_ID=PERFTEST
FM_RECORD_ID=99999

# 任意：プロキシ経由する場合 (例: http://proxy:8080)
# HTTPS_PROXY=
